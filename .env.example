# Postgres connection string. Supabase, a local cluster, or any managed Postgres.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/fantasy_football

# Signing secret for session tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Where the web app is served from; used to build invite and magic links.
APP_URL=http://localhost:5173

# NFL season the app defaults to.
SEASON=2025

# 1 logs magic links and invites to the console instead of emailing them.
DEV_EMAIL_TO_CONSOLE=1
